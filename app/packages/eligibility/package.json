{
  "name": "@onepercent/eligibility",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./xray-result": {
      "types": "./src/xray-result.ts",
      "development": "./src/xray-result.ts",
      "import": "./dist/xray-result.js"
    },
    "./format": {
      "types": "./src/format.ts",
      "development": "./src/format.ts",
      "import": "./dist/format.js"
    },
    "./copy": {
      "types": "./src/copy.ts",
      "development": "./src/copy.ts",
      "import": "./dist/copy.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --preserve-symlinks ../../scripts/test.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "1.99.0",
    "@solana/spl-token": "0.4.15",
    "zod": "4.6.5",
    "@onepercent/copy": "workspace:*",
    "@onepercent/config": "workspace:*"
  }
}
