{
  "name": "@onepercent/market",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "development": "./src/testing.ts",
      "import": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @onepercent/config build && tsc -p tsconfig.build.json",
    "typecheck": "pnpm --filter @onepercent/config build && tsc --noEmit",
    "test": "pnpm --filter @onepercent/config build && node --preserve-symlinks ../../scripts/test.mjs",
    "fixtures:record": "pnpm --filter @onepercent/config build && tsx scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@onepercent/config": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  }
}
