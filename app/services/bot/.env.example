# Optional Telegram bot token. Unset or empty disables the bot with exit status 0.
TELEGRAM_BOT_TOKEN=
# Pino level. Optional; defaults to info.
LOG_LEVEL=

# Must equal API WEB_ORIGIN. HTTPS except localhost; default http://localhost:5173.
PUBLIC_WEB_URL=
# API origin, HTTPS except local/private hosts; default http://localhost:3000.
PUBLIC_API_URL=
# Optional server-to-server bearer, at least 32 characters. Never expose as VITE_.
# Unset disables wallet linking. Must match the API BOT_API_SECRET.
BOT_API_SECRET=

# B1: optional locally; required for durable bot state on Railway. Never run migrations from the bot.
DATABASE_URL=
# Private health and readiness only; defaults to 127.0.0.1:3001.
PRIVATE_HOST=
PRIVATE_PORT=
# Stored preferences remain available; notification delivery starts in B2.
FLAG_BOT_ALERTS=
