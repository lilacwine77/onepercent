# Removed in S0: WORKER_TICK_MS; the heartbeat stub no longer runs.
# Worker jobs use SERVICES scheduling parameters.
# Removed in S0: WORKER_HEALTH_PORT; use PRIVATE_PORT instead.
# Private health defaults to port 3001.
# Pino level. Optional; defaults to info.
LOG_LEVEL=

# S0 role runtime. Export only the selected service environment, never a shared key file.
# Cluster: localnet (default), devnet, mainnet-beta.
CLUSTER=
# Required PostgreSQL, Redis and per-service RPC connection URLs.
DATABASE_URL=
REDIS_URL=
RPC_URL=
# Required deployed program address (Config PDA is derived from this address).
PROGRAM_ID=
# Frozen protocol address lookup table, verified against chain before use.
PROTOCOL_LOOKUP_TABLE=
# Required private salt for client-IP hashes.
LOG_IP_SALT=
# Private health/ready/metrics listener; defaults to 127.0.0.1:3001.
# On Railway set PRIVATE_HOST=:: for its private IPv6 network; do not expose publicly.
PRIVATE_HOST=
PRIVATE_PORT=
# Optional alert destination; payloads are sanitized before delivery.
ALERT_WEBHOOK_URL=
# indexer (default), keeper, executor or monitor.
ROLE=
# Set ONLY the selected hot-role variable; indexer/monitor have no key.
# KEEPER_KEYPAIR=
# EXECUTOR_KEYPAIR=

# S1: required Triton HTTP fallback for ROLE=indexer. Never put a signing key here.
INDEXER_RPC_URL_FALLBACK=
# Optional WebSocket endpoint; defaults to RPC_URL with the ws/wss scheme.
INDEXER_WS_URL=

# K1: default off still plans, builds and simulates without sending.
FLAG_KEEPER_STOCK_LIVE=off
# Active, frozen protocol lookup table for the configured cluster.
STOCK_PROTOCOL_LUT=
# X2 evidence/quotes for this keeper. Never share an intake signing credential.
JUPITER_API_KEY=
PYTH_HERMES_API_KEY=

# M4.2 executor. Mainnet requires the shared landing measurements.
# Devnet uses devnet-rpc-p75-v1 (measured p75, capped, no Sender tip).
EXECUTOR_SWAP=jupiter
EXECUTOR_JUPITER_API_KEY=
# Devnet/localnet only: a rehearsal-owned wSOL account that receives test swap input.
EXECUTOR_STUB_QUOTE_ACCOUNT=
# Mainnet only; leave unset on devnet.
HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
