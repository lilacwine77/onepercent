{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --preserve-symlinks ../../scripts/test.mjs",
    "indexer:replay": "node dist/indexer/replay-cli.js",
    "stock:dry-run": "node dist/keeper/stock/dry-run.js",
    "executor:dry-run": "tsx src/executor/dry-run.ts"
  },
  "dependencies": {
    "@onepercent/config": "workspace:*",
    "@onepercent/sdk": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.9",
    "pino": "10.3.1",
    "zod": "4.6.5",
    "@onepercent/service-kit": "workspace:*",
    "@onepercent/db": "workspace:*",
    "@onepercent/market": "workspace:*",
    "@onepercent/cli": "workspace:*"
  }
}
