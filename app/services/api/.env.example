# HTTP listen port. Optional; defaults to 3000.
PORT=
# Single permitted browser origin. Optional; defaults to http://localhost:5173.
WEB_ORIGIN=
# Version returned by GET /health. Optional; defaults to the M0 version 0.0.0.
APP_VERSION=
# Commit returned by GET /health. Optional; defaults to unknown.
GIT_COMMIT=
# Pino level. Optional; defaults to info.
LOG_LEVEL=

# X-ray provider credentials. Server-only; URL takes precedence over the key.
HELIUS_API_KEY=
HELIUS_RPC_URL=
# Optional Jupiter key; keyless defaults to 0.5 requests/second, keyed to 1.
JUPITER_API_KEY=
JUPITER_MAX_RPS=
# live or fixtures; defaults to live with a Helius setting, otherwise fixtures.
XRAY_SOURCE=
# Optional .sns resolution; disabled by default. D9 keeps .sol unsupported.
XRAY_SNS_ENABLED=false
# Optional season snapshot slot, checked only for in-set mints.
FEED_SNAPSHOT_SLOT=
# Public share origins; default http://localhost:5173 and http://localhost:3000.
PUBLIC_WEB_URL=
PUBLIC_API_URL=
# Optional built HTML shell URL for share metadata injection.
WEB_SHELL_URL=
# Trusted reverse-proxy IP header, otherwise the socket address is used.
TRUST_PROXY_HEADER=
# Reserved for a future verifier; X1 ships an explicitly logged noop verifier.
TURNSTILE_SECRET=
# Optional shared bot/API bearer secret, at least 32 characters. Never use VITE_.
# Unset disables bot-only linking. WEB_ORIGIN must equal the bot PUBLIC_WEB_URL.
BOT_API_SECRET=

# S0 role runtime. Export only the selected service environment, never a shared key file.
# Cluster: localnet (default), devnet, mainnet-beta.
CLUSTER=
# Required PostgreSQL, Redis and per-service RPC connection URLs.
DATABASE_URL=
REDIS_URL=
RPC_URL=
# Required deployed program address (Config PDA is derived from this address).
PROGRAM_ID=
# Required private salt for client-IP hashes.
LOG_IP_SALT=
# Private health/ready/metrics listener; defaults to 127.0.0.1:3001.
# On Railway set PRIVATE_HOST=:: for its private IPv6 network; do not expose publicly.
PRIVATE_HOST=
PRIVATE_PORT=
# Optional alert destination; payloads are sanitized before delivery.
ALERT_WEBHOOK_URL=
# public (default), intake-signer or quote-signer.
ROLE=
# Required only for signers: at least 32 characters, different for each signer.
INTERNAL_TOKEN=
# Set ONLY the selected signer variable in its private environment, never both.
# INTAKE_SIGNER_KEYPAIR=
# QUOTE_SIGNER_KEYPAIR=

# M3 web routes: public addresses only, verified on chain by the browser.
PROTOCOL_LUT_ADDRESS=
ADMIN_MULTISIG_ADDRESS=

# X-ray shell flag before the M2 config route is available. on/off or true/false.
FLAG_XRAY=
# Preview web builds only: flows that run live or on their demo adapter,
# e.g. xray=live,feed=demo,rip=demo,cards=demo,verify=demo,wallet=demo.
# Leave empty in production (the response then has no modes).
WEB_FLOW_MODES=

# S4 public role: distinct private signer credentials (D13 naming).
INTAKE_SIGNER_URL=http://intake-signer.railway.internal:3001
INTAKE_INTERNAL_TOKEN=
QUOTE_SIGNER_URL=http://quote-signer.railway.internal:3001
QUOTE_INTERNAL_TOKEN=

# M5 flags: only the literal 'on' enables a flag; unset is off.
# B1 enables the X-ray Action; B2 adds Rip. Feed remains deferred.
FLAG_BLINKS_XRAY=
FLAG_BLINKS_FEED=
FLAG_BLINKS_RIP=

# M5 B2: Rip Actions require both FLAG_BLINKS_RIP and FLAG_PACKS.
FLAG_PACKS=
# PUBLIC_API_URL above is the public image origin, never a private RPC URL.
# CLUSTER selects Rip's Actions chain id; X-ray remains mainnet.
