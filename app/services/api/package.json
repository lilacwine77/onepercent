{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --preserve-symlinks scripts/test.mjs",
    "xray:smoke": "tsx src/xray/smoke.ts",
    "blinks:check": "node --conditions=development --import tsx src/actions/check.ts",
    "blinks:e2e": "node --conditions=development --import tsx src/actions/tests/e2e-validator.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "hono": "4.13.9",
    "pino": "10.3.1",
    "zod": "4.6.5",
    "@onepercent/eligibility": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "@bonfida/spl-name-service": "4.1.0-beta.1",
    "satori": "0.33.5",
    "@resvg/resvg-js": "2.6.2",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@onepercent/market": "workspace:*",
    "@onepercent/config": "workspace:*",
    "@onepercent/service-kit": "workspace:*",
    "@onepercent/db": "workspace:*",
    "@onepercent/copy": "workspace:*",
    "@onepercent/web-api": "workspace:*",
    "@onepercent/sdk": "workspace:*"
  },
  "devDependencies": {
    "@solana/actions-spec": "2.4.2"
  }
}
