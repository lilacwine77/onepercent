{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --preserve-symlinks --preserve-symlinks-main ../../scripts/web.mjs dev",
    "build": "tsc --noEmit && node --preserve-symlinks --preserve-symlinks-main ../../scripts/web.mjs build",
    "build:preview": "node scripts/build-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --preserve-symlinks ../../scripts/test.mjs --maxWorkers=2",
    "preview": "node --preserve-symlinks --preserve-symlinks-main ../../scripts/web.mjs preview",
    "test:e2e:webgl": "playwright test --project webgl-smoke",
    "test:e2e:fixtures": "playwright test --project fixtures",
    "test:e2e:captures": "playwright test --config e2e/visual/playwright.config.ts",
    "test:e2e:validator": "playwright test --project validator",
    "test:e2e:devnet": "playwright test --project devnet",
    "test:chain": "tsc --noEmit -p tests/chain/tsconfig.json && node --preserve-symlinks ../../scripts/test.mjs --config vitest.chain.config.ts",
    "assets:landing": "node scripts/sync-landing-assets.mjs",
    "budget": "node scripts/budget.mjs",
    "lcp": "node scripts/lcp.mjs",
    "test:static": "node --test scripts/*.test.mjs && node scripts/static-checks.mjs",
    "dist:check": "node scripts/check-dist.mjs",
    "lint:words": "node scripts/lint-words.mjs",
    "test:e2e:validator:run": "tsx e2e/validator/run.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@solana/wallet-standard-features": "1.5.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@onepercent/eligibility": "workspace:*",
    "zod": "4.6.5",
    "@onepercent/config": "workspace:*",
    "@onepercent/copy": "workspace:*",
    "@onepercent/web-api": "workspace:*",
    "@onepercent/sdk": "workspace:*",
    "@solana/web3.js": "1.99.0",
    "@solana/spl-token": "0.4.15",
    "three": "0.180.0",
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "vite": "8.3.1",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "litesvm": "0.8.0",
    "@types/three": "0.180.0"
  }
}
