# Optional local settings. Empty entries use the documented service defaults.
# API listener port (default: 3000).
PORT=
# Allowed browser origin (default: http://localhost:5173).
WEB_ORIGIN=
# Version reported by the API health endpoint (default: 0.0.0).
APP_VERSION=
# Source commit reported by the API health endpoint (default: unknown).
GIT_COMMIT=
# Pino log level (default: info).
LOG_LEVEL=
# Removed in S0: WORKER_TICK_MS; the heartbeat stub no longer runs.
# Worker jobs use SERVICES scheduling parameters.
# Removed in S0: WORKER_HEALTH_PORT; use PRIVATE_PORT instead.
# Private health defaults to port 3001.
# Optional Telegram token. Unset or empty disables the bot.
TELEGRAM_BOT_TOKEN=
# Browser API base URL (default: http://localhost:3000). Public, never a secret.
VITE_API_URL=
# Optional Cargo output directory; normally left unset (default: app/target).
CARGO_TARGET_DIR=
# The Anchor runner pins this to 1.90.0; direct CLI usage needs the same version.
RUSTUP_TOOLCHAIN=

# X-ray provider credentials. Server-only; URL takes precedence over the key.
HELIUS_API_KEY=
HELIUS_RPC_URL=
# Optional Jupiter key; keyless defaults to 0.5 requests/second, keyed to 1.
JUPITER_API_KEY=
JUPITER_MAX_RPS=
# live or fixtures; defaults to live with a Helius setting, otherwise fixtures.
XRAY_SOURCE=
# Optional .sns resolution; disabled by default. D9 keeps .sol unsupported.
XRAY_SNS_ENABLED=false
# Optional season snapshot slot, checked only for in-set mints.
FEED_SNAPSHOT_SLOT=
# Public share origins; default http://localhost:5173 and http://localhost:3000.
PUBLIC_WEB_URL=
PUBLIC_API_URL=
# Optional built HTML shell URL for share metadata injection.
WEB_SHELL_URL=
# Trusted reverse-proxy IP header, otherwise the socket address is used.
TRUST_PROXY_HEADER=
# Reserved for a future verifier; X1 ships an explicitly logged noop verifier.
TURNSTILE_SECRET=
# Optional shared bot/API bearer secret, at least 32 characters. Never use VITE_.
# Unset disables bot-only linking. WEB_ORIGIN must equal the bot PUBLIC_WEB_URL.
BOT_API_SECRET=

# S0 role runtime. Export only the selected service environment, never a shared key file.
# Cluster: localnet (default), devnet, mainnet-beta.
# CLUSTER and PROGRAM_ID also pin the live web build; provide both as Docker build args.
CLUSTER=
# Required PostgreSQL, Redis and per-service RPC connection URLs.
DATABASE_URL=
REDIS_URL=
RPC_URL=
# Required deployed program address (Config PDA is derived from this address).
PROGRAM_ID=
# Required private salt for client-IP hashes.
LOG_IP_SALT=
# Private health/ready/metrics listener; defaults to 127.0.0.1:3001.
# On Railway set PRIVATE_HOST=:: for its private IPv6 network; do not expose publicly.
PRIVATE_HOST=
PRIVATE_PORT=
# Optional alert destination; payloads are sanitized before delivery.
ALERT_WEBHOOK_URL=
# Select one process role (see its own .env.example).
ROLE=
# Integration tests require explicit opt-in and isolated local service URLs.
SERVICES_INTEGRATION=
TEST_DATABASE_URL=
TEST_REDIS_URL=

# M3 browser values are public; never put provider credentials in VITE variables.
# Same-origin /api is recommended. VITE_API_URL above remains supported.
VITE_TURNSTILE_SITE_KEY=
VITE_CLUSTER=devnet
# Caddy web container upstream, e.g. api.railway.internal:3000.
API_UPSTREAM=
# Optional public addresses exposed by /api/web/config; checked on chain by users.
PROTOCOL_LUT_ADDRESS=
ADMIN_MULTISIG_ADDRESS=
# M3: TURNSTILE_SECRET above is required with XRAY_SOURCE=live.
# The no-op verifier is permitted only with XRAY_SOURCE=fixtures and in tests.

# M5 flags; only 'on' enables one. B1 ships the X-ray Action flag.
FLAG_BLINKS_XRAY=
FLAG_BLINKS_FEED=
FLAG_BLINKS_RIP=
FLAG_BOT_ALERTS=
# Bot deployments now also set DATABASE_URL, PRIVATE_HOST and PRIVATE_PORT.

# Optional local Redis-only signer integration check.
S2_REDIS_INTEGRATION=

# M5 B2 public API: Rip Actions need FLAG_BLINKS_RIP above and FLAG_PACKS.
FLAG_PACKS=
